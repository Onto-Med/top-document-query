{
  "$id": "https://github.com/Onto-Med/top-document-query/blob/main/src/main/resources/text_adapter_config_schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TOP Text Adapter Configuration Schema",
  "description": "Schema of TOP text adapter configurations",
  "definitions": {
    "authentication": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      },
      "required": ["username"]
    },
    "conceptGraph": {
      "type": "object",
      "properties": {
        "connection": {
          "$ref": "#/definitions/connection"
        }
      },
      "required": ["connection"]
    },
    "connection": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "IP or hostname to connect to"
        },
        "port": {
          "type": "integer",
          "description": "Port to connect to"
        }
      },
      "required": ["url"]
    },
    "queryExpansion": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "description": "Concept Graphs query-expansion profile referenced by this data source"
        },
        "relations": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/queryExpansionRelation"
          }
        }
      },
      "required": ["profile"]
    },
    "queryExpansionRelation": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "alternatives",
            "optional_context",
            "require_context",
            "exclude_context",
            "recall_expansion",
            "specificity_focus",
            "proximity_context",
            "phrase_context",
            "ignore"
          ]
        }
      },
      "required": ["strategy"]
    }
  },
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "adapter": {
      "type": "string"
    },
    "connection": {
      "$ref": "#/definitions/connection"
    },
    "dateFiled": {
      "type": "string"
    },
    "index": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "field": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "batchSize": {
      "type": "integer"
    },
    "replaceFields": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "conceptGraph": {
      "$ref": "#/definitions/conceptGraph"
    },
    "queryExpansion": {
      "$ref": "#/definitions/queryExpansion"
    }
  },
  "required": ["id", "adapter", "connection"]
}
